# Portainer (Access Token des Benutzers "mcp", nicht des Admins)
PORTAINER_URL=https://portainer.example.com
PORTAINER_API_KEY=
PORTAINER_TLS_VERIFY=1

# Nginx Proxy Manager - intern über das gemeinsame Docker-Netz
NPM_URL=http://npm:81/api
NPM_USER=
NPM_PASSWORD=
# Nur für NPM bis v2.12 nötig; ab v2.13 nimmt NPM die E-Mail des NPM-Benutzers
NPM_DEFAULT_EMAIL=
# Docker-Netz, in dem NPM hängt (neue Dienste müssen darin hängen)
NPM_DOCKER_NETWORK=npm_default

# Öffentliche IP, auf die neue Domains zeigen müssen
PUBLIC_IP=203.0.113.10

# Zusätzlich zu den festen Mustern portainer*, nginx-proxy-manager*, npm*, infra-mcp*
PROTECTED_CONTAINERS=
PROTECTED_STACKS=
# Pflicht für schreibende NPM-Tools
PROTECTED_DOMAINS=portainer.example.com,npm.example.com,infra-mcp.example.com

# Statisches Bearer-Token für den Connector (z.B. openssl rand -hex 32)
MCP_API_KEY=

# Host-Ressourcen (node-exporter-Sidecar im Stack), Messintervall in Sekunden
NODE_EXPORTER_URL=http://infra-mcp-node-exporter:9100/metrics
METRICS_INTERVAL=60

# Host-Port und Bind-Adresse
MCP_HOST_PORT=8426
MCP_BIND_ADDR=0.0.0.0
